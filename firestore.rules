rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function tourn(code) {
      return get(/databases/$(database)/documents/tournaments/$(code)).data;
    }
    function isOrg(code) {
      return signedIn() && tourn(code).organizerId == request.auth.uid;
    }
    // Visibilidad configurable: 'never' | 'always' | 'end' (al finalizar).
    function shared(code, field) {
      let t = tourn(code);
      return t.get(field, 'never') == 'always'
        || (t.get(field, 'never') == 'end' && t.status == 'finished');
    }
    // Reclamo de logro válido según su tipo (ver claimId en lib/logic/league.dart).
    function claimKeyOk(code, key, d) {
      let a = tourn(code).achievements[d.ach];
      let base = 'r' + string(d.round) + '-' + d.ach;
      return (a.type == 'player' && key == base + '-' + d.pid)
        || (a.type == 'round' && key == base)
        || (a.type == 'unlimited' && key.matches(base + '-' + d.pid + '-[a-z0-9]+'));
    }
    // Grupos de organizadores: groups/{id}.members incluye al dueño.
    function groupMembers(gid) {
      return get(/databases/$(database)/documents/groups/$(gid)).data.members;
    }
    // Mantenedores: los propios (rosters/{uid}) o los de un grupo al que
    // pertenezco (rosters/g_{id}).
    function canRoster(owner) {
      return signedIn() && (request.auth.uid == owner
        || (owner.matches('^g_[A-Za-z0-9]+$')
            && request.auth.uid in groupMembers(owner.split('_')[1])));
    }
    function seatOf(code, round) {
      return get(/databases/$(database)/documents/tournaments/$(code)/rounds/$('r' + string(round))).data.seatOf;
    }

    // Lista personal de torneos (organizados / unidos), nick y preguntas guardadas.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Grupos: el dueño agrega/quita miembros; los miembros registran
    // torneos en el historial y pueden salirse.
    match /groups/{gid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid];
      allow update: if signedIn() && (
        (resource.data.owner == request.auth.uid
          && request.resource.data.owner == resource.data.owner
          && request.auth.uid in request.resource.data.members)
        || (request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tournaments']))
        || (request.auth.uid in resource.data.members
          && request.auth.uid != resource.data.owner
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.toSet() == resource.data.members.toSet().difference([request.auth.uid].toSet())));
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
    }

    // Mantenedores (jugadores, preguntas, logros): propios o de un grupo.
    match /rosters/{owner} {
      allow read, write: if canRoster(owner);
      match /people/{id} {
        allow read, write: if canRoster(owner);
      }
      match /achievements/{id} {
        allow read, write: if canRoster(owner);
      }
    }
    // Cada persona puede leer las fichas vinculadas a su cuenta en cualquier
    // mantenedor (para su historial de torneos).
    match /{path=**}/people/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Claves de ronda de liga → torneo y número de ronda.
    match /roundKeys/{key} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && key.matches('^[A-Z0-9]{6}$')
        && tourn(request.resource.data.code).organizerId == request.auth.uid;
      allow delete: if signedIn() && tourn(resource.data.code).organizerId == request.auth.uid;
    }

    match /tournaments/{code} {
      // Se puede abrir un torneo conociendo su clave, pero no listar todos.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && code.matches('^[A-Z0-9]{6}$')
        && request.resource.data.organizerId == request.auth.uid
        && canRoster(request.resource.data.get('ownerId', request.auth.uid));
      // Solo el organizador modifica el torneo y no puede transferirlo.
      allow update: if signedIn()
        && resource.data.organizerId == request.auth.uid
        && request.resource.data.organizerId == resource.data.organizerId;
      allow delete: if signedIn() && resource.data.organizerId == request.auth.uid;

      match /players/{pid} {
        allow read: if signedIn();
        // Un jugador (o el organizador) se inscribe a sí mismo; el organizador agrega a cualquiera.
        allow create: if isOrg(code) || (
          signedIn() && pid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && tourn(code).status != 'finished');
        // El jugador solo puede cambiar su nick, hacer drop o informar si usa Google.
        allow update: if isOrg(code) || (
          signedIn() && pid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nick', 'dropped', 'google']));
        allow delete: if isOrg(code);
      }

      // Comandante y lista: el organizador y el propio jugador; el resto solo si se comparten.
      match /decks/{pid} {
        allow get: if isOrg(code) || (signedIn() && pid == request.auth.uid) || (signedIn() && shared(code, 'shareDecks'));
        allow list: if isOrg(code) || (signedIn() && shared(code, 'shareDecks'));
        allow write: if isOrg(code) || (signedIn() && pid == request.auth.uid);
      }

      // Rondas, mesas y resultados oficiales: solo el organizador.
      match /rounds/{rid} {
        allow read: if signedIn();
        allow write: if isOrg(code);
      }

      // Reportes: solo alguien sentado en esa mesa, en la ronda actual.
      match /reports/{key} {
        allow read: if signedIn();
        allow delete: if isOrg(code);
        allow create, update: if isOrg(code) || (
          signedIn()
          && request.resource.data.by == request.auth.uid
          && request.resource.data.round == tourn(code).currentRound
          && key == 'r' + string(request.resource.data.round) + '-t' + string(request.resource.data.table)
          && seatOf(code, request.resource.data.round)[request.auth.uid] == request.resource.data.table);
      }

      // Liga: inscripción a cada ronda (id r{n}-{pid}).
      match /entries/{key} {
        allow read: if signedIn();
        allow create: if isOrg(code) || (signedIn()
          && request.resource.data.pid == request.auth.uid
          && key == 'r' + string(request.resource.data.round) + '-' + request.auth.uid
          && request.resource.data.round == tourn(code).currentRound
          && tourn(code).status in ['registration', 'prep']);
        allow update: if isOrg(code);
        allow delete: if isOrg(code) || (signedIn()
          && resource.data.pid == request.auth.uid
          && tourn(code).status in ['registration', 'prep']);
      }

      // Liga: logros obtenidos. El jugador reclama los suyos durante la ronda,
      // según las reglas de cada tipo; el organizador puede modificar todo.
      match /claims/{key} {
        allow read: if isOrg(code)
          || (signedIn() && shared(code, 'shareAchievements'))
          || (signedIn() && resource.data.pid == request.auth.uid);
        allow create: if isOrg(code) || (signedIn()
          && request.resource.data.pid == request.auth.uid
          && request.resource.data.round == tourn(code).currentRound
          && tourn(code).status == 'round'
          && tourn(code).achievementsOn == true
          && tourn(code).achievements[request.resource.data.ach].type != 'auto'
          && request.auth.uid in seatOf(code, request.resource.data.round)
          && claimKeyOk(code, key, request.resource.data));
        allow update: if isOrg(code);
        allow delete: if isOrg(code) || (signedIn()
          && resource.data.pid == request.auth.uid
          && resource.data.round == tourn(code).currentRound
          && tourn(code).status == 'round');
      }

      // Votos especiales: id r{n}-{uid}. Cada jugador vota solo por sí mismo,
      // en la ronda actual y estando sentado en una mesa.
      match /votes/{key} {
        allow get: if isOrg(code)
          || (signedIn() && key.split('-')[1] == request.auth.uid)
          || (signedIn() && shared(code, 'shareVotes'));
        allow list: if isOrg(code) || (signedIn() && shared(code, 'shareVotes'));
        allow delete: if isOrg(code);
        allow create, update: if signedIn()
          && request.resource.data.by == request.auth.uid
          && request.resource.data.round == tourn(code).currentRound
          && key == 'r' + string(request.resource.data.round) + '-' + request.auth.uid
          && request.auth.uid in seatOf(code, request.resource.data.round);
      }
    }
  }
}
