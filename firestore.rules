rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function tourn(code) {
      return get(/databases/$(database)/documents/tournaments/$(code)).data;
    }
    function isOrg(code) {
      return signedIn() && tourn(code).organizerId == request.auth.uid;
    }
    // Visibilidad configurable: 'never' | 'always' | 'end' (al finalizar).
    function shared(code, field) {
      let t = tourn(code);
      return t.get(field, 'never') == 'always'
        || (t.get(field, 'never') == 'end' && t.status == 'finished');
    }
    function seatOf(code, round) {
      return get(/databases/$(database)/documents/tournaments/$(code)/rounds/$('r' + string(round))).data.seatOf;
    }

    // Lista personal de torneos (organizados / unidos), nick y preguntas guardadas.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Mantenedores (jugadores, preguntas). Hoy el dueño es el propio
    // organizador; a futuro, una comunidad con varios organizadores.
    match /rosters/{owner} {
      allow read, write: if signedIn() && request.auth.uid == owner;
      match /people/{id} {
        allow read, write: if signedIn() && request.auth.uid == owner;
      }
    }
    // Cada persona puede leer las fichas vinculadas a su cuenta en cualquier
    // mantenedor (para su historial de torneos).
    match /{path=**}/people/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /tournaments/{code} {
      // Se puede abrir un torneo conociendo su clave, pero no listar todos.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && code.matches('^[A-Z0-9]{6}$')
        && request.resource.data.organizerId == request.auth.uid;
      // Solo el organizador modifica el torneo y no puede transferirlo.
      allow update: if signedIn()
        && resource.data.organizerId == request.auth.uid
        && request.resource.data.organizerId == resource.data.organizerId;
      allow delete: if signedIn() && resource.data.organizerId == request.auth.uid;

      match /players/{pid} {
        allow read: if signedIn();
        // Un jugador (o el organizador) se inscribe a sí mismo; el organizador agrega a cualquiera.
        allow create: if isOrg(code) || (
          signedIn() && pid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && tourn(code).status != 'finished');
        // El jugador solo puede cambiar su nick, hacer drop o informar si usa Google.
        allow update: if isOrg(code) || (
          signedIn() && pid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nick', 'dropped', 'google']));
        allow delete: if isOrg(code);
      }

      // Comandante y lista: el organizador y el propio jugador; el resto solo si se comparten.
      match /decks/{pid} {
        allow get: if isOrg(code) || (signedIn() && pid == request.auth.uid) || (signedIn() && shared(code, 'shareDecks'));
        allow list: if isOrg(code) || (signedIn() && shared(code, 'shareDecks'));
        allow write: if isOrg(code) || (signedIn() && pid == request.auth.uid);
      }

      // Rondas, mesas y resultados oficiales: solo el organizador.
      match /rounds/{rid} {
        allow read: if signedIn();
        allow write: if isOrg(code);
      }

      // Reportes: solo alguien sentado en esa mesa, en la ronda actual.
      match /reports/{key} {
        allow read: if signedIn();
        allow delete: if isOrg(code);
        allow create, update: if isOrg(code) || (
          signedIn()
          && request.resource.data.by == request.auth.uid
          && request.resource.data.round == tourn(code).currentRound
          && key == 'r' + string(request.resource.data.round) + '-t' + string(request.resource.data.table)
          && seatOf(code, request.resource.data.round)[request.auth.uid] == request.resource.data.table);
      }

      // Votos especiales: id r{n}-{uid}. Cada jugador vota solo por sí mismo,
      // en la ronda actual y estando sentado en una mesa.
      match /votes/{key} {
        allow get: if isOrg(code)
          || (signedIn() && key.split('-')[1] == request.auth.uid)
          || (signedIn() && shared(code, 'shareVotes'));
        allow list: if isOrg(code) || (signedIn() && shared(code, 'shareVotes'));
        allow delete: if isOrg(code);
        allow create, update: if signedIn()
          && request.resource.data.by == request.auth.uid
          && request.resource.data.round == tourn(code).currentRound
          && key == 'r' + string(request.resource.data.round) + '-' + request.auth.uid
          && request.auth.uid in seatOf(code, request.resource.data.round);
      }
    }
  }
}
